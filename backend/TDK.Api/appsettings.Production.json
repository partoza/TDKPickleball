{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "TDKApi",
    "Audience": "TDKUsers",
    "AdminSessionHours": 24,
    "CustomerSessionHours": 2
  },
  "Smtp": {
    "Port": 587,
    "EnableSsl": true
  },
  "Cloudinary": {
    "Folder": "tdk/users"
  },
  "GoogleSheets": {
    "Enabled": false,
    "BookingsTabName": "Bookings",
    "CustomersTabName": "Customers",
    "SyncIntervalSeconds": 60
  },
  "RateLimiting": {
    "GlobalPermitLimit": 300,
    "GlobalWindowSeconds": 60,
    "PublicReadPermitLimit": 120,
    "PublicReadWindowSeconds": 60,
    "AuthenticationPermitLimit": 10,
    "AuthenticationWindowMinutes": 5,
    "EmailPermitLimit": 10,
    "EmailWindowMinutes": 10
    ,"NfcPermitLimit": 20
    ,"NfcWindowMinutes": 5
  }
}
