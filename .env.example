# ASP.NET Core backend configuration. Use double underscores for nested keys.
# Keep real secrets in the hosting provider or `dotnet user-secrets`, never here.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:5000

ConnectionStrings__DefaultConnection=
Jwt__Key=
Jwt__Issuer=TDKApi
Jwt__Audience=TDKUsers
Jwt__AdminSessionHours=24
Jwt__CustomerSessionHours=2

# Required in Production to create the first administrator account.
# After the account is created, keep these values in the hosting provider only.
SeedAdmin__Email=
SeedAdmin__Password=

Smtp__Host=smtp.gmail.com
Smtp__Port=587
Smtp__EnableSsl=true
Smtp__From=
Smtp__Username=
Smtp__Password=
Smtp__StoreEmail=

# Create OAuth 2.0 Web credentials in Google Cloud Console.
# Add the frontend URLs under Authorized JavaScript origins. Redirect URIs are not used.
Authentication__Google__ClientId=

Cloudinary__CloudName=
Cloudinary__ApiKey=
Cloudinary__ApiSecret=
Cloudinary__Folder=tdk/users

Frontend__BaseUrl=
Cors__AllowedOrigins__0=

# Optional rate-limit overrides. The values below match the application defaults.
RateLimiting__GlobalPermitLimit=300
RateLimiting__GlobalWindowSeconds=60
RateLimiting__PublicReadPermitLimit=120
RateLimiting__PublicReadWindowSeconds=60
RateLimiting__AuthenticationPermitLimit=10
RateLimiting__AuthenticationWindowMinutes=5
RateLimiting__EmailPermitLimit=10
RateLimiting__EmailWindowMinutes=10

# Vite frontend configuration (set separately in Vercel or frontend/.env.local).
VITE_API_URL=
VITE_GOOGLE_CLIENT_ID=
